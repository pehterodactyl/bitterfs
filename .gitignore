# ===========================================================================
# bitterfs — ignored build products
# ===========================================================================
# Note the omission: the kernel source tree is not listed, because it lives
# outside this repo entirely (~/kernels/...).  Source is ~1.5G and a build adds
# ~20G; keeping it out of the working tree is a deliberate layout decision, not
# something .gitignore papers over.  See config.mk.

# --- Kbuild intermediates --------------------------------------------------
# Kbuild scatters these liberally through any directory it builds in, including
# hidden .*.cmd files recording the exact command used for each object.
*.ko
*.o
*.o.*
*.mod
*.mod.c
*.mod.o
*.symvers
*.order
.*.cmd
.tmp_versions/
modules.order
Module.symvers

# --- QEMU guest artifacts --------------------------------------------------
# initramfs.cpio.gz is regenerated by `make -C qemu initramfs` in ~200ms.
# bitter.img is a sparse 1G disk image — and more importantly it is TEST STATE,
# not source: committing it would mean committing whatever half-written
# transaction the last crash test left behind.
qemu/initramfs.cpio.gz
qemu/*.img

# --- core/ and user/ build products (phase 1+) -----------------------------
# *.d are the header-dependency files written by -MMD; *.a is core/libbitter.a.
# Neither was covered by the Kbuild patterns above.
*.a
*.d

# The table generator's binary is a build product; its OUTPUT
# (core/crc32c_table.h) is committed source and deliberately not listed.
core/gen_crc32c_table
core/*.h.tmp
tools/gen_crc32c_table

user/mkfs.bitterfs
user/bitter-dump
user/bitter-fsck
tests/**/*.img
tests/**/*.out
# Test binaries: one per unit/NAME.c, no extension.
tests/unit/*
!tests/unit/*.c
tests/*.o
tests/*.d

# --- LaTeX ---------------------------------------------------------------
# Everything lands in docs/build/, but the loose-file patterns are kept as a
# safety net for the times latexmk is run by hand without -outdir.
docs/build/
*.aux
*.fdb_latexmk
*.fls
*.out
*.toc
*.synctex.gz

# --- Development tooling ---------------------------------------------------
# Generated by the kernel tree's scripts/gen_compile_commands.py and by ctags /
# cscope; useful locally, meaningless to anyone else.
compile_commands.json
tags
TAGS
cscope.*

# --- Editor and OS noise ---------------------------------------------------
*.swp
*.swo
*~
.DS_Store
