# ===========================================================================
# bitterfs guest kernel — config fragment
# ===========================================================================
#
# This file holds ONLY the deltas.  The full guest config is built in three
# layers, and keeping them separate is what makes the setup reproducible when
# you bump to a new point release (or a new LTS) months from now:
#
#   1. `make defconfig`         — minimal bootable x86-64 kernel.  Roughly a
#                                 tenth the size of a distro config, which is
#                                 why it builds in minutes rather than an hour.
#   2. `make kvm_guest.config`  — the tree's own fragment for running as a KVM
#                                 guest (arch/x86/configs/kvm_guest.config).
#                                 Supplies virtio block, virtio console, the
#                                 8250 serial port the console rides on, and
#                                 the 9p transport for the source share.
#   3. this file                — the debugging machinery.  defconfig gives you
#                                 a kernel that boots; none of it gives you a
#                                 kernel that is pleasant to debug a broken
#                                 filesystem inside of.
#
# Regenerate with:  make -C qemu config
# Verify with:      make -C qemu check
#
# Pinned kernel: 6.12 LTS.  VFS method signatures churn between releases (see
# Documentation/filesystems/porting.rst) — do not drift off this series
# mid-project without reading that file first.
# ===========================================================================


# ---------------------------------------------------------------------------
# Symbols and debug info — the prerequisite for everything else
# ---------------------------------------------------------------------------
# DEBUG_INFO is not directly settable in modern kernels; you select it by
# choosing a DWARF flavour.  TOOLCHAIN_DEFAULT lets gcc pick the version it
# emits natively, which avoids DWARF-5-vs-binutils mismatches on some distros.
#
# GDB_SCRIPTS is the one that earns its keep: it builds vmlinux-gdb.py, which
# provides `lx-symbols`.  That command locates your module's load address in
# the running guest and tells gdb where its symbols live.  Without it,
# debugging a module means hand-computing section offsets out of
# /sys/module/bitterfs/sections/.  With it, you breakpoint `btree_search` by
# name in a live kernel.
#
# DEBUG_INFO_REDUCED must stay off — it strips exactly the struct layout
# information you need to inspect a bitter_header at a breakpoint.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_GDB_SCRIPTS=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y


# ---------------------------------------------------------------------------
# Memory error detection — KASAN
# ---------------------------------------------------------------------------
# Shadow-maps kernel memory and traps out-of-bounds accesses and use-after-free
# AT THE INSTRUCTION THAT COMMITS THEM, with backtraces for both the allocation
# and the free.  For a filesystem this is the single highest-value option here:
# it converts "an inode got corrupted somehow, three minutes and a thousand
# operations ago" into "line 214 wrote 8 bytes past a leaf freed at line 190."
#
# INLINE vs OUTLINE is a build-size/runtime-speed trade: INLINE emits the shadow
# checks inline instead of calling out to a helper, producing a noticeably
# larger image but a meaningfully faster guest.  For an interactive dev loop,
# guest speed is what you feel.
#
# Cost, stated honestly: roughly 2x build time and a 2-3x slower guest.  That is
# an obviously good trade for correctness work on a learning filesystem.  Turn
# it off only if you ever benchmark bitterfs for real.
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_INLINE=y
# CONFIG_KASAN_OUTLINE is not set


# ---------------------------------------------------------------------------
# Locking correctness — lockdep
# ---------------------------------------------------------------------------
# PROVE_LOCKING builds a directed graph of every lock-acquisition order the
# kernel has ever observed, and reports the moment you take two locks in an
# order that COULD deadlock — even when the deadlock does not actually occur on
# this run.  That "even when it doesn't happen" is the whole point: lock-order
# bugs are load- and timing-dependent, so testing alone will not find them.
#
# DEBUG_ATOMIC_SLEEP catches calling a sleeping function while holding a
# spinlock or otherwise in atomic context.  Filesystem code does this by
# accident constantly, because sb_bread(), kmalloc(GFP_KERNEL), and anything
# that touches the page cache can all sleep.  Undetected it presents as an
# intermittent hang under load; detected, it is an immediate stack trace naming
# the exact call.
#
# Both matter from phase 7 onward (see SKELETON.md hard spot 6), but they cost
# nothing to have on early and will catch mistakes before you know to look.
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_RWSEMS=y


# ---------------------------------------------------------------------------
# Data structure integrity
# ---------------------------------------------------------------------------
# Validate linked-list pointers and object lifecycle on every operation, so
# corruption is caught where it is introduced rather than at the next traversal.
# In a filesystem those two points can be minutes and a thousand operations
# apart, and the traversal site tells you nothing about the culprit.
#
# SLUB_DEBUG adds allocator red zones and poisoning; it overlaps with KASAN but
# catches a few things KASAN does not, and costs little.
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_FREE=y
CONFIG_SLUB_DEBUG=y


# ---------------------------------------------------------------------------
# Liveness and escape hatches
# ---------------------------------------------------------------------------
# DETECT_HUNG_TASK fires a stack trace when a task sits in uninterruptible sleep
# past a timeout — which is precisely what a deadlocked filesystem looks like
# from the outside.  Without it, a hung `ls` gives you a silent, dead terminal.
#
# MAGIC_SYSRQ lets you extract state from a guest that has stopped responding
# normally.  Over the QEMU serial console: Ctrl-A then 'c' for the monitor, or
# `sendkey` sysrq combinations — `w` dumps blocked tasks, `l` dumps all CPU
# backtraces.  This is how you diagnose a hang you cannot otherwise interrupt.
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=60
CONFIG_MAGIC_SYSRQ=y
CONFIG_PANIC_ON_OOPS=n
CONFIG_DEBUG_FS=y


# ---------------------------------------------------------------------------
# Module loading
# ---------------------------------------------------------------------------
# The dev loop is: build bitterfs.ko on the host, insmod in the guest, unload,
# fix, repeat.  MODULE_UNLOAD makes that loop possible at all.
#
# FORCE_UNLOAD is the escape hatch for when your module's reference counting is
# wrong and rmmod refuses.  Use it knowing what it means: you are unloading code
# the kernel still believes is in use, which can panic immediately.  That is
# still better than rebooting on every iteration — and in a throwaway VM, a
# panic costs one second.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y


# ---------------------------------------------------------------------------
# Determinism for debugging
# ---------------------------------------------------------------------------
# KASLR randomises the kernel's load address at boot, so addresses printed in an
# oops will not match the symbols in your vmlinux.  Disabling it here means you
# cannot forget the `nokaslr` boot argument — belt and braces, since forgetting
# it costs you a confusing debugging session rather than an obvious error.
# CONFIG_RANDOMIZE_BASE is not set


# ---------------------------------------------------------------------------
# Guest I/O — re-asserted deliberately
# ---------------------------------------------------------------------------
# kvm_guest.config should already supply all of these.  They are repeated here
# so that if that fragment ever changes upstream, `make -C qemu check` fails
# loudly at config time instead of the guest booting to a kernel panic with no
# root device, or silently lacking the 9p share that the whole dev loop rides on.
#
#   VIRTIO_BLK  — /dev/vda, the raw bitterfs image as a real block device
#   9P/9P_VIRTIO— mount -t 9p the host source tree, so `insmod` sees a fresh
#                 build without rebuilding any image
#   SERIAL_8250 — where printk goes, and where your shell lives (-nographic)
#   BLK_DEV_LOOP— loop-mount images inside the guest, useful for comparing
#                 against ext4/btrfs behaviour on the same data
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y


# ---------------------------------------------------------------------------
# Deliberately NOT enabled (notes for later)
# ---------------------------------------------------------------------------
# CONFIG_DEBUG_KMEMLEAK   — finds leaked allocations, but is slow and produces
#                           false positives that cost more time than it saves at
#                           this stage.  Worth a one-off run near phase 9.
# CONFIG_UBSAN            — undefined-behaviour sanitiser.  Useful once the
#                           on-disk format code is doing real pointer
#                           arithmetic inside leaves (SKELETON.md 3.3).
# CONFIG_FAULT_INJECTION  — with FAIL_MAKE_REQUEST, lets you inject block I/O
# CONFIG_FAIL_MAKE_REQUEST  errors to exercise error paths that are otherwise
#                           unreachable.  Turn on at phase 9 alongside the
#                           crash tests.
# CONFIG_BTRFS_FS         — the real thing.  Enable when you want to compare
#                           bitterfs behaviour against it on the same workload.
